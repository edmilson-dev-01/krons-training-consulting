# This project currently requires NO secrets, API keys, or environment
# variables to run — it is a static marketing site with no backend, database
# or third-party API integration (see docs/environment-variables.md).
#
# The variables below are optional runtime settings, mostly relevant when
# running the production build or the Docker image. Copy this file to `.env`
# only if you need to override a default.

# Port the Next.js server listens on (default: 3000)
# PORT=3000

# Standard Next.js environment (development | production | test)
# NODE_ENV=production
